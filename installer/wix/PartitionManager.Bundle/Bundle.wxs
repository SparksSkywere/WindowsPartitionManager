<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">

  <Bundle Name="Partition Manager"
          Version="1.0.0"
          Manufacturer="Skywere Industries"
          UpgradeCode="C8B2D5F3-7E49-50A1-8C23-6F9D1B4E8A27"
          Copyright="Copyright (c) Skywere Industries"
          IconSourceFile="..\..\..\assets\app.ico"
          DisableModify="yes"
          DisableRemove="no">

    <Variable Name="InstallFolder"
              Type="formatted"
              Value="[ProgramFiles64Folder]PartitionManager\"
              bal:Overridable="yes" />

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
          LicenseUrl="https://opensource.org/licenses/MIT"
          Theme="hyperlinkLicense"
          SuppressOptionsUI="yes"
          SuppressDowngradeFailure="no"
          ShowVersion="yes" />
    </BootstrapperApplication>

    <Chain DisableSystemRestore="no">
      <MsiPackage Id="PartitionManagerMsi"
                  SourceFile="$(var.PartitionManager.Installer.TargetPath)"
                  DisplayName="Partition Manager"
                  Visible="yes"
                  Compressed="yes"
                  Vital="yes"
                  Permanent="no"
                  ForcePerMachine="yes"
                  bal:DisplayInternalUICondition="WixBundleAction = 6">
        <MsiProperty Name="ARPSYSTEMCOMPONENT" Value="0" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
