<Window x:Class="PartitionManager.Views.ResizePartitionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resize partition"
        Height="440" Width="480"
        MinHeight="400" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Icon="pack://application:,,,/Assets/app.ico">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="MoveToStartButton" Content="Move to start" Width="110" Height="28" Margin="0,0,8,0"
                    Click="MoveToStart_Click" Style="{StaticResource SecondaryButtonStyle}"
                    ToolTip="Place the partition at the start of the adjacent free region."/>
            <Button Content="OK" Width="88" Height="28" Margin="0,0,8,0" IsDefault="True"
                    Click="Ok_Click" Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="Cancel" Width="88" Height="28" IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>
        <StackPanel>
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <TextBlock Text="Unallocated before (MB)" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <DockPanel Margin="0,0,0,8">
                <TextBox x:Name="BeforeBox" Width="90" DockPanel.Dock="Right" Margin="8,0,0,0"
                         TextChanged="BeforeBox_TextChanged"/>
                <Slider x:Name="BeforeSlider" TickFrequency="1"
                        ValueChanged="BeforeSlider_ValueChanged"/>
            </DockPanel>

            <TextBlock Text="Partition size (MB)" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <DockPanel Margin="0,0,0,8">
                <TextBox x:Name="SizeBox" Width="90" DockPanel.Dock="Right" Margin="8,0,0,0"
                         TextChanged="SizeBox_TextChanged"/>
                <Slider x:Name="SizeSlider" TickFrequency="1"
                        ValueChanged="SizeSlider_ValueChanged"/>
            </DockPanel>

            <TextBlock Text="Unallocated after (MB)" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <DockPanel>
                <TextBox x:Name="AfterBox" Width="90" DockPanel.Dock="Right" Margin="8,0,0,0"
                         TextChanged="AfterBox_TextChanged"/>
                <Slider x:Name="AfterSlider" TickFrequency="1"
                        ValueChanged="AfterSlider_ValueChanged"/>
            </DockPanel>

            <TextBlock x:Name="RangeText" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,8"/>
            <TextBlock x:Name="HintText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                       Text="Adjacent free space is included. Move to start slides the partition."/>
        </StackPanel>
    </DockPanel>
</Window>
