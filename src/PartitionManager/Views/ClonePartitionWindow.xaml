<Window x:Class="PartitionManager.Views.ClonePartitionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clone partition"
        Height="400" Width="520"
        MinHeight="360" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Icon="pack://application:,,,/Assets/app.ico">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" Width="88" Height="28" Margin="0,0,8,0" IsDefault="True"
                    Click="Ok_Click" Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="Cancel" Width="88" Height="28" IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>
        <StackPanel>
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <TextBlock Text="Destination unallocated space" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox x:Name="DestBox" Margin="0,0,0,12" DisplayMemberPath="Display"/>

            <TextBlock Text="Copy mode" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <RadioButton x:Name="UsedRadio" Content="Used data (skip free space, faster)" IsChecked="True"
                         Margin="0,0,0,4"/>
            <RadioButton x:Name="AllRadio" Content="All sectors" Margin="0,0,0,12"/>

            <CheckBox x:Name="AlignBox" Content="Align to 1 MB" IsChecked="True" Margin="0,0,0,4"/>
            <CheckBox x:Name="FillBox" Content="Fill the destination region" Margin="0,0,0,12"/>

            <TextBlock x:Name="WarningText" TextWrapping="Wrap"
                       Foreground="{DynamicResource AccentBrush}"/>
        </StackPanel>
    </DockPanel>
</Window>
