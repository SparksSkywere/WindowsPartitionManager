<Window x:Class="PartitionManager.Views.EncryptionRequiredWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Device encryption"
        Height="220" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Icon="pack://application:,,,/Assets/app.ico">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Open settings" Width="120" Height="28" Margin="0,0,8,0"
                    Click="OpenSettings_Click" Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="Close" Width="88" Height="28" IsCancel="True"
                    Click="Close_Click" Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>
        <TextBlock x:Name="MessageText" TextWrapping="Wrap"/>
    </DockPanel>
</Window>
