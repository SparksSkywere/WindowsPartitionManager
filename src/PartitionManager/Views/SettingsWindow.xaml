<Window x:Class="PartitionManager.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options"
        Height="560" Width="520"
        MinHeight="440" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Icon="pack://application:,,,/Assets/app.ico">

    <DockPanel Margin="12" Background="{DynamicResource WindowBackgroundBrush}">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="88" Height="28" Margin="0,0,8,0"
                    IsDefault="True" Click="Ok_Click"
                    Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="Cancel" Width="88" Height="28"
                    IsCancel="True" Click="Cancel_Click"
                    Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>

        <TabControl>
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Startup" Style="{StaticResource SectionHeaderStyle}"/>
                        <CheckBox Content="Refresh disks when the window opens"
                                  IsChecked="{Binding RefreshOnLaunch}"/>

                        <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderStyle}" Margin="0,18,0,8"/>
                        <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding ThemeOptions}"
                                  SelectedItem="{Binding SelectedTheme}"
                                  DisplayMemberPath="Label"
                                  Width="280" HorizontalAlignment="Left"/>
                        <TextBlock Text="Default is System (follows Windows light/dark). Other options are era styles from Chronolog (Windows 95 through Windows 11 Dark)."
                                   Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap"/>

                        <TextBlock Text="Display" Style="{StaticResource SectionHeaderStyle}" Margin="0,18,0,8"/>
                        <CheckBox Content="Show removable disks (USB)" IsChecked="{Binding ShowRemovable}"/>
                        <CheckBox Content="Show virtual disks" IsChecked="{Binding ShowVirtual}"/>
                        <CheckBox Content="Show unallocated regions" IsChecked="{Binding ShowUnallocated}"/>
                        <CheckBox Content="Show EFI / MSR reserved partitions" IsChecked="{Binding ShowSystemReserved}"/>

                        <TextBlock Text="Safety" Style="{StaticResource SectionHeaderStyle}" Margin="0,18,0,8"/>
                        <CheckBox Content="Confirm destructive operations (delete, format, convert)"
                                  IsChecked="{Binding ConfirmDestructive}"/>
                        <CheckBox Content="Protect boot and system partitions from delete / format / hide"
                                  IsChecked="{Binding ProtectSystemPartitions}"/>

                        <TextBlock Text="Feedback" Style="{StaticResource SectionHeaderStyle}" Margin="0,18,0,8"/>
                        <Button Content="Open GitHub feedback…" HorizontalAlignment="Left"
                                Padding="10,4" Command="{Binding OpenFeedbackCommand}"
                                Style="{StaticResource ToolbarButtonStyle}"/>

                        <TextBlock Text="Desktop shortcuts" Style="{StaticResource SectionHeaderStyle}" Margin="0,18,0,8"/>
                        <TextBlock Text="{Binding ShortcutStatus}" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Create desktop shortcut" Padding="10,4" Margin="0,0,8,0"
                                    Command="{Binding CreateDesktopShortcutCommand}"
                                    Style="{StaticResource ToolbarButtonStyle}"/>
                            <Button Content="Remove desktop shortcut" Padding="10,4"
                                    Command="{Binding RemoveDesktopShortcutCommand}"
                                    Style="{StaticResource ToolbarButtonStyle}"/>
                        </StackPanel>

                        <TextBlock Text="Configuration file" Style="{StaticResource SectionHeaderStyle}" Margin="0,18,0,8"/>
                        <Border Background="{DynamicResource HeaderBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrushSubtle}"
                                BorderThickness="1" CornerRadius="3" Padding="8,6"
                                SnapsToDevicePixels="True">
                            <TextBox Text="{Binding ConfigPath, Mode=OneWay}"
                                     IsReadOnly="True" TextWrapping="Wrap"
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     CaretBrush="{DynamicResource PrimaryTextBrush}"
                                     SelectionBrush="{DynamicResource ListSelectionBrush}"
                                     Padding="0"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
