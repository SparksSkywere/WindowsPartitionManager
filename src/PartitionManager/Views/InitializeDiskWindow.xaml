<Window x:Class="PartitionManager.Views.InitializeDiskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Initialize disk"
        Height="240" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Icon="pack://application:,,,/Assets/app.ico">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" Width="88" Height="28" Margin="0,0,8,0" IsDefault="True"
                    Click="Ok_Click" Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="Cancel" Width="88" Height="28" IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>
        <StackPanel>
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBlock Text="Partition style" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <RadioButton x:Name="GptRadio" Content="GPT (recommended for disks larger than 2 TB and UEFI)" IsChecked="True"/>
            <RadioButton x:Name="MbrRadio" Content="MBR (legacy BIOS, 2 TB limit)"/>
        </StackPanel>
    </DockPanel>
</Window>
