<Window x:Class="PartitionManager.Views.CloneDiskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clone disk"
        Height="460" Width="520"
        MinHeight="420" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Icon="pack://application:,,,/Assets/app.ico">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" Width="88" Height="28" Margin="0,0,8,0" IsDefault="True"
                    Click="Ok_Click" Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="Cancel" Width="88" Height="28" IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>
        <StackPanel>
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <TextBlock Text="Source disk" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox x:Name="SourceBox" Margin="0,0,0,12" DisplayMemberPath="Display"
                      SelectionChanged="Selection_Changed"/>

            <TextBlock Text="Destination disk" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox x:Name="DestBox" Margin="0,0,0,12" DisplayMemberPath="Display"
                      SelectionChanged="Selection_Changed"/>

            <TextBlock Text="Copy mode" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <RadioButton x:Name="UsedRadio" Content="Used data (skip free space, faster)" IsChecked="True"
                         Margin="0,0,0,4"/>
            <RadioButton x:Name="AllRadio" Content="All sectors (exact copy of each partition)"
                         Margin="0,0,0,12"/>

            <CheckBox x:Name="AlignBox" Content="Align partitions to 1 MB" IsChecked="True" Margin="0,0,0,4"/>
            <CheckBox x:Name="ExpandBox" Content="Expand the last data partition if the destination is larger"
                      Margin="0,0,0,12"/>

            <TextBlock x:Name="HintText" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}"/>
            <TextBlock x:Name="WarningText" TextWrapping="Wrap" Margin="0,8,0,0"
                       Foreground="{DynamicResource AccentBrush}"/>
        </StackPanel>
    </DockPanel>
</Window>
