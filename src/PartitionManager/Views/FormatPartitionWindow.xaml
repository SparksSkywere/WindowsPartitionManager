<Window x:Class="PartitionManager.Views.FormatPartitionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Format partition"
        Height="300" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Icon="pack://application:,,,/Assets/app.ico">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" Width="88" Height="28" Margin="0,0,8,0" IsDefault="True"
                    Click="Ok_Click" Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="Cancel" Width="88" Height="28" IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>
        <StackPanel>
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBlock Text="File system" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox x:Name="FileSystemBox" Width="160" HorizontalAlignment="Left" Margin="0,0,0,12"/>
            <TextBlock Text="Volume label" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="LabelBox" MaxLength="32" Margin="0,0,0,12"/>
            <CheckBox x:Name="QuickBox" Content="Quick format" IsChecked="True"/>
            <TextBlock Text="Formatting erases all files on this volume. The change stays pending until you click Apply."
                       Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
    </DockPanel>
</Window>
