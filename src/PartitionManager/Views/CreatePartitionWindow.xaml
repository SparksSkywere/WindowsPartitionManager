<Window x:Class="PartitionManager.Views.CreatePartitionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create partition"
        Height="420" Width="460"
        MinHeight="380" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Icon="pack://application:,,,/Assets/app.ico">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" Width="88" Height="28" Margin="0,0,8,0" IsDefault="True"
                    Click="Ok_Click" Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="Cancel" Width="88" Height="28" IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>
        <StackPanel>
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBlock Text="Size (MB)" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <DockPanel>
                <TextBox x:Name="SizeBox" Width="90" DockPanel.Dock="Right" Margin="8,0,0,0"
                         TextChanged="SizeBox_TextChanged"/>
                <Slider x:Name="SizeSlider" Minimum="1" TickFrequency="1" IsSnapToTickEnabled="False"
                        ValueChanged="SizeSlider_ValueChanged"/>
            </DockPanel>
            <TextBlock x:Name="SizeHint" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,12"/>

            <TextBlock Text="Drive letter" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox x:Name="LetterBox" Width="160" HorizontalAlignment="Left" Margin="0,0,0,12"/>

            <TextBlock Text="File system" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox x:Name="FileSystemBox" Width="160" HorizontalAlignment="Left" Margin="0,0,0,12"/>

            <TextBlock Text="Label" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="LabelBox" MaxLength="32" Margin="0,0,0,12"/>

            <CheckBox x:Name="FormatBox" Content="Format this partition" IsChecked="True"/>
            <CheckBox x:Name="QuickBox" Content="Quick format" IsChecked="True" Margin="20,0,0,0"/>
        </StackPanel>
    </DockPanel>
</Window>
