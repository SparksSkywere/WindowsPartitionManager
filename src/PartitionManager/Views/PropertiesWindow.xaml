<Window x:Class="PartitionManager.Views.PropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Properties"
        Height="460" Width="480"
        MinHeight="320" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Icon="pack://application:,,,/Assets/app.ico">
    <DockPanel Margin="16">
        <Button DockPanel.Dock="Bottom" Content="OK" Width="88" Height="28" HorizontalAlignment="Right"
                Margin="0,16,0,0" IsDefault="True" IsCancel="True"
                Style="{StaticResource PrimaryButtonStyle}"/>
        <ListView x:Name="PropList" BorderBrush="{DynamicResource BorderBrushSubtle}">
            <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource ThemedGridViewColumnHeader}">
                    <GridViewColumn Header="Property" Width="160" DisplayMemberBinding="{Binding Key}"/>
                    <GridViewColumn Header="Value" Width="260" DisplayMemberBinding="{Binding Value}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
