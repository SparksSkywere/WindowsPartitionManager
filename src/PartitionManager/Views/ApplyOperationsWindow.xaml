<Window x:Class="PartitionManager.Views.ApplyOperationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apply pending operations"
        Height="420" Width="520"
        MinHeight="320" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Icon="pack://application:,,,/Assets/app.ico">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <TextBlock x:Name="WarningText" TextWrapping="Wrap" Margin="0,0,0,12"
                       Foreground="{DynamicResource AccentBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Apply" Width="100" Height="28" Margin="0,0,8,0" IsDefault="True"
                        Click="Ok_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                <Button Content="Cancel" Width="88" Height="28" IsCancel="True"
                        Style="{StaticResource SecondaryButtonStyle}"/>
            </StackPanel>
        </StackPanel>
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="The following operations will be committed to the live disks. This cannot be undone from this application."/>
            <ListBox x:Name="OpList" BorderBrush="{DynamicResource BorderBrushSubtle}"/>
        </DockPanel>
    </DockPanel>
</Window>
