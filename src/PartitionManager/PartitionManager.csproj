<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Baked into EXE; file synced from assets\installer.ico before each build -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>PartitionManager</AssemblyName>
    <RootNamespace>PartitionManager</RootNamespace>
    <Product>Partition Manager</Product>
    <Title>Partition Manager</Title>
    <AssemblyTitle>Partition Manager</AssemblyTitle>
    <Company>Skywere Industries</Company>
    <Authors>Skywere Industries</Authors>
    <Copyright>Copyright © Skywere Industries</Copyright>
    <Description>Manage disks and partitions on Windows: create, delete, format, resize, change drive letters and labels, initialize MBR/GPT, and apply queued operations with a live disk map preview.</Description>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <NeutralLanguage>en-US</NeutralLanguage>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.Management" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\config.default.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <Target Name="SyncProductionIcon" BeforeTargets="PrepareForBuild;BeforeBuild;BeforePublish">
    <PropertyGroup>
      <_InstallerIco>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\assets\installer.ico'))</_InstallerIco>
      <_AppIco>$(MSBuildProjectDirectory)\Assets\app.ico</_AppIco>
    </PropertyGroup>
    <Copy SourceFiles="$(_InstallerIco)" DestinationFiles="$(_AppIco)" SkipUnchangedFiles="false"
          Condition="Exists('$(_InstallerIco)')" />
    <Message Importance="high" Text="Synced app icon from assets\installer.ico" Condition="Exists('$(_InstallerIco)')" />
  </Target>

</Project>
